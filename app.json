{
  "expo": {
    "name": "TXK Arion-630",
    "slug": "txk-arion630",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "txkarion630",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "android": {
      "package": "uz.txk.arion630"
    },
    "ios": {
      "supportsTablet": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-audio",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
